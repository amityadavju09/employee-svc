{
  "family": "employee-db",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "employee-db",
      "image": "366486935206.dkr.ecr.us-east-1.amazonaws.com/employee-db:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 5432, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "POSTGRES_DB", "value": "company_db" },
        { "name": "POSTGRES_SCHEMA", "value": "employee" },
        { "name": "POSTGRES_USER", "value": "postgres" },
        { "name": "POSTGRES_PASSWORD", "value": "postgres" }
      ]
    }
  ]
}
